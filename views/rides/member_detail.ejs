<% layout("/layout/boilerplate.ejs") %>
<body>
<div class="page">

  <!-- Header -->
  <div class="header-row">
    <button class="back-btn" onclick="history.back()" aria-label="Go back">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>
    <h1 class="page-title">Member Profile</h1>
  </div>

  <!-- Avatar block -->
  <div class="avatar-block">
    <div class="avatar-circle">JR</div>
    <h2 class="member-name">James Rodriguez</h2>
    <span class="status-badge">Active</span>
  </div>

  <!-- Info list -->
  <div class="info-list">

    <!-- Phone -->
    <div class="info-card" style="animation-delay:0s">
      <div class="info-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.28h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.77a16 16 0 0 0 6 6l.86-.86a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.5 16z"/>
        </svg>
      </div>
      <div>
        <p class="info-label">Phone</p>
        <p class="info-value">+1 555-0102</p>
      </div>
    </div>

    <!-- Email -->
    <div class="info-card" style="animation-delay:0.05s">
      <div class="info-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
      </div>
      <div>
        <p class="info-label">Email</p>
        <p class="info-value">james.r@email.com</p>
      </div>
    </div>

    <!-- Bike -->
    <div class="info-card" style="animation-delay:0.1s">
      <div class="info-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="5.5" cy="17.5" r="3.5"/><circle cx="18.5" cy="17.5" r="3.5"/>
          <path d="M15 6a1 1 0 0 0-1-1h-1l-5 5h7l-1-4z"/>
          <path d="M9 6l-2 5"/>
        </svg>
      </div>
      <div>
        <p class="info-label">Bike Model</p>
        <p class="info-value">Kawasaki Z900</p>
      </div>
    </div>

    <!-- Member ID -->
    <div class="id-card">
      <p class="id-label">Member ID</p>
      <p class="id-value">RS-2024-0042</p>
    </div>

    <!-- Stats grid -->
    <div class="stats-grid">
      <div class="stat-card">
        <p class="stat-value">23</p>
        <p class="stat-label">Rides</p>
      </div>
      <div class="stat-card">
        <p class="stat-value">1.2k km</p>
        <p class="stat-label">Distance</p>
      </div>
      <div class="stat-card">
        <p class="stat-value">Jan '24</p>
        <p class="stat-label">Joined</p>
      </div>
    </div>

  </div>
</div>
</body>

