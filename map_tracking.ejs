<% layout("/layout/boilerplate.ejs") %>
<script>
  const map_token = "<%= map_token %>"
  const sorce_cordinates= '<%- JSON.stringify(data.sorcelocation) %>';
  const destination_cordinates = '<%= JSON.stringify(data.destinationlocation) %>';
</script>
<body>

<!-- MAP (z=0, always behind everything) -->
<div id="map"></div>

<!-- HEADER (z=30, floats over map) -->
<div id="map-header">
  <div class="hdr-btn" onclick="history.back()">
    <i class="fa-solid fa-arrow-left" style="font-size:.8rem;"></i>
  </div>
  <div class="hdr-center">
    <div class="ride-name">
      <%= data.sorce +" -> " + data.destination %>
    </div>
    <div class="mem-pill">
      <div class="mini-avs">
        <div class="mav" style="background:linear-gradient(135deg,#6c63ff,#a29bfe);">R</div>
        <div class="mav" style="background:linear-gradient(135deg,#ff6584,#ffb547);">P</div>
        <div class="mav" style="background:linear-gradient(135deg,#4fc3f7,#38bd67);">A</div>
        <div class="mav" style="background:linear-gradient(135deg,#38bd67,#6c63ff);">S</div>
      </div>
      <%= "3/" + data.members.length %>
    </div>
  </div>
  <!-- <div class="hdr-btn">
    <i class="fa-solid fa-ellipsis-vertical" style="font-size:.8rem;"></i>
  </div> -->
</div>

<!-- SLIDE PANEL (z=20, floats over map) -->
<div id="slide-panel">

  <div id="drag-handle">
    <div class="handle-bar"></div>
    <span id="hint-text">
      <i class="fa-solid fa-chevron-up" style="font-size:.52rem;margin-right:4px;"></i>
      Slide up for trip details
    </span>
  </div>

  <div id="panel-tabs">
    <div class="tab-btn active" data-tab="trip">Trip Plan</div>
    <div class="tab-btn" data-tab="members">Members</div>
    <div class="tab-btn" data-tab="chat">Chat</div>
  </div>

  <div id="panel-body">

    <!-- TRIP PLAN -->
    <div class="tab-pane active" id="tab-trip">
      <div class="trip-summary">
        <div class="sum-card">
          <i class="fa-solid fa-route" style="color:#6c63ff;"></i>
          <div class="val">342 km</div><div class="lbl">Distance</div>
        </div>
        <div class="sum-card">
          <i class="fa-solid fa-clock" style="color:#ffb547;"></i>
          <div class="val">7h 20m</div><div class="lbl">Total ETA</div>
        </div>
        <div class="sum-card">
          <i class="fa-solid fa-gas-pump" style="color:#4fc3f7;"></i>
          <div class="val">3 Stops</div><div class="lbl">Fuel</div>
        </div>
      </div>

      <div class="stop-list">
        <div class="stop-line"></div>

        <div class="stop-card">
          <div class="stop-dot sd-start"></div>
          <div class="stop-row"><div class="stop-name">
            <%= data.sorc %>
          </div></div>
          <div class="stop-meta"><i class="fa-solid fa-circle-play" style="color:#6c63ff;"></i>Start · Departed 6:00 AM</div>
        </div>

        <div class="stop-card">
          <div class="stop-dot sd-fuel"></div>
          <div class="stop-row">
            <div class="stop-name">Café XYZ — NH48</div>
            <div class="eta ef">ETA 8 min</div>
          </div>
          <div class="stop-meta"><i class="fa-solid fa-mug-hot" style="color:#ffb547;"></i>Stop 1 · Fuel &amp; Breakfast</div>
        </div>

        <div class="stop-card">
          <div class="stop-dot sd-scene"></div>
          <div class="stop-row">
            <div class="stop-name">Sunset Viewpoint</div>
            <div class="eta es">ETA 55 min</div>
          </div>
          <div class="stop-meta"><i class="fa-solid fa-mountain-sun" style="color:#4fc3f7;"></i>Stop 2 · Scenic Point</div>
        </div>

        <div class="stop-card">
          <div class="stop-dot sd-fuel"></div>
          <div class="stop-row">
            <div class="stop-name">Guru Shikhar Junction</div>
            <div class="eta ef">ETA 2h 10m</div>
          </div>
          <div class="stop-meta"><i class="fa-solid fa-gas-pump" style="color:#ffb547;"></i>Stop 3 · Last fuel stop</div>
        </div>

        <div class="stop-card">
          <div class="stop-dot sd-end"></div>
          <div class="stop-row">
            <div class="stop-name">Mount Abu — Nakki Lake</div>
            <div class="eta ed">ETA 3h 40m</div>
          </div>
          <div class="stop-meta"><i class="fa-solid fa-flag-checkered" style="color:#ff6584;"></i>Destination · Final Stop</div>
        </div>
      </div>
    </div>

    <!-- MEMBERS -->
    <div class="tab-pane" id="tab-members">
      <% for( let m of data.members) { %>
        <%
          function rand(){
          return Math.floor(Math.random()*256);
        }

        const c1 = `rgb(${rand()},${rand()},${rand()})`;
        const c2 = `rgb(${rand()},${rand()},${rand()})`;
        %>
        <div class="member-card">
          <div class="mem-av" style="background:linear-gradient(135deg,#ff6584,#ffb547);">
            <%= m.firstname.charAt(0) + m.lastname.charAt(0) %>
          </div>
          <div>
            <div class="mem-name">
              <%= m.firstname + " " + m.lastname %>
            </div>
            <div class="mem-role"><i class="fa-solid fa-steering-wheel" style="color:#ffb547;font-size:.63rem;margin-right:3px;"></i>Driver</div>
          </div>
          <span class="mem-st son">● Online</span>
        </div>
      <% } %>
      <!-- <div class="member-card">
        <div class="mem-av" style="background:linear-gradient(135deg,#ff6584,#ffb547);">PS</div>
        <div>
          <div class="mem-name">Priya Sharma</div>
          <div class="mem-role"><i class="fa-solid fa-map" style="color:#ffb547;font-size:.63rem;margin-right:3px;"></i>Navigator</div>
        </div>
        <span class="mem-st son">● Online</span>
      </div>
      <div class="member-card">
        <div class="mem-av" style="background:linear-gradient(135deg,#4fc3f7,#38bd67);">AJ</div>
        <div>
          <div class="mem-name">Arjun Joshi</div>
          <div class="mem-role"><i class="fa-solid fa-camera" style="color:#4fc3f7;font-size:.63rem;margin-right:3px;"></i>Photographer</div>
        </div>
        <span class="mem-st soff">Offline</span>
      </div>
      <div class="member-card">
        <div class="mem-av" style="background:linear-gradient(135deg,#38bd67,#6c63ff);">SM</div>
        <div>
          <div class="mem-name">Sneha Mehra</div>
          <div class="mem-role"><i class="fa-solid fa-utensils" style="color:#38bd67;font-size:.63rem;margin-right:3px;"></i>Food Scout</div>
        </div>
        <span class="mem-st son">● Online</span>
      </div> -->
    </div>

    <!-- CHAT -->
    <div class="tab-pane" id="tab-chat">
      <div class="cbubble">
        <div class="cav" style="background:linear-gradient(135deg,#ff6584,#ffb547);">PS</div>
        <div><div class="bbl">Everyone ready? Departing in 5 mins! 🚗<span class="bt">5:55 AM</span></div></div>
      </div>
      <div class="cbubble me">
        <div class="cav">RK</div>
        <div><div class="bbl">Yes! Starting the car now.<span class="bt">5:56 AM</span></div></div>
      </div>
      <div class="cbubble">
        <div class="cav" style="background:linear-gradient(135deg,#4fc3f7,#38bd67);">AJ</div>
        <div><div class="bbl">Can we stop at the Sunset Viewpoint for photos? 📸<span class="bt">6:02 AM</span></div></div>
      </div>
      <div class="cbubble me">
        <div class="cav">RK</div>
        <div><div class="bbl">Already added it to the route! 👍<span class="bt">6:03 AM</span></div></div>
      </div>
      <div class="cbubble">
        <div class="cav" style="background:linear-gradient(135deg,#38bd67,#6c63ff);">SM</div>
        <div><div class="bbl">Café XYZ has amazing poha and chai ☕<span class="bt">6:10 AM</span></div></div>
      </div>
    </div>

  </div><!-- /panel-body -->

  <div id="chat-bar">
    <input class="cinput" id="chat-text" type="text" placeholder="Type a message…" />
    <button class="sbtn" onclick="sendMsg()">
      <i class="fa-solid fa-paper-plane" style="font-size:.76rem;"></i>
    </button>
  </div>

</div><!-- /slide-panel -->

</body>
