        <%= data.firstname && data.lastname ? data.firstname.charAt(0).toUpperCase() + data.lastname.charAt(0).toUpperCase() : data.username.charAt(0).toUpperCase() %>
      </div>
      <div class="profile-info">
        <p class="profile-name">
          <%= data.firstname && data.lastname ? data.firstname + " " + data.lastname : data.username %>
        </p>
        <div class="profile-meta">
          <span class="badge-admin">Admin</span>
          <span class="profile-email"><%= data.email %></span>
        </div>
      </div>
      <i class="bi bi-chevron-right chevron"></i>
    </button>
  
