<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content="Live ride tracking — follow your group in real time with turn-by-turn navigation." />
  <meta name="theme-color" content="#2563eb" />
  <title><%= rideData.ridename %> · RideSync Live</title>

  <!-- Mapbox GL CSS + JS (standalone page — must include directly) -->
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.css" rel="stylesheet" />
  <script src="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.js"></script>

  <!-- Google Font: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Map Page Styles -->
  <link rel="stylesheet" href="/css/map_page.css" />

  <style>
    /* Inline critical: font override for Inter */
    html, body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
  </style>
</head>

<body>

  <!-- ══════════════════════════════════════════════════
       MAP CANVAS (z-index: 0)
       ══════════════════════════════════════════════════ -->
  <div id="map"></div>

  <!-- ══════════════════════════════════════════════════
       LOADING SCREEN
       ══════════════════════════════════════════════════ -->
  <div id="map-loader" class="map-loading">
    <div class="spinner"></div>
    <p>Loading map…</p>
  </div>

  <!-- ══════════════════════════════════════════════════
       TOP BAR (z-index: 1000)
       ══════════════════════════════════════════════════ -->
  <header id="top-bar" role="banner">
    <button id="btn-back" aria-label="Go back" title="Back">&#8592;</button>

    <div class="top-bar-center">
      <div id="ride-name-display" title="<%= rideData.ridename %>">
        <%= rideData.ridename %>
      </div>
      <div id="live-count-label">Loading riders…</div>
    </div>

    <div id="top-bar-avatar" aria-label="Your avatar">
      <%
        const currentMember = rideData.members.find(m => m._id.toString() === userid);
        let avatarInitials = '??';
        if (currentMember) {
          const fn = (currentMember.firstname || '').trim();
          const ln = (currentMember.lastname  || '').trim();
          if (fn || ln) {
            avatarInitials = ((fn[0] || '') + (ln[0] || '')).toUpperCase() || (fn.substring(0,2).toUpperCase());
          } else {
            avatarInitials = (currentMember.username || 'U').substring(0, 2).toUpperCase();
          }
        }
      %>
      <%= avatarInitials %>
    </div>
  </header>

  <!-- ══════════════════════════════════════════════════
       NAVIGATION PANEL (z-index: 999) — hidden by default
       Shown when ride status becomes "active"
       ══════════════════════════════════════════════════ -->
  <nav id="nav-panel" aria-label="Turn-by-turn navigation" aria-live="polite">
    <div id="nav-icon" aria-hidden="true">↑</div>
    <div class="nav-text">
      <div id="nav-instruction">Calculating route…</div>
      <div id="nav-sub">— remaining · ETA: —</div>
    </div>
    <button id="btn-speaker" aria-label="Toggle voice navigation" title="Toggle voice">🔊</button>
  </nav>

  <!-- ══════════════════════════════════════════════════
       SEARCH BAR (z-index: 900)
       ══════════════════════════════════════════════════ -->
  <div id="search-bar" role="search" aria-label="Search places on map">
    <div class="search-input-wrapper">
      <span class="search-icon" aria-hidden="true">🔍</span>
      <input
        id="search-input"
        type="search"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        placeholder="Search places…"
        aria-label="Search places"
      />
      <button id="search-clear" class="search-clear" aria-label="Clear search">✕</button>
    </div>
    <div id="search-dropdown" role="listbox" aria-label="Search results"></div>
  </div>

  <!-- ══════════════════════════════════════════════════
       RIGHT FLOATING CONTROLS (z-index: 800)
       ══════════════════════════════════════════════════ -->
  <div id="right-controls" role="group" aria-label="Map controls">
    <button id="btn-sos" class="map-ctrl-btn sos-ctrl-btn" aria-label="Trigger SOS" title="Trigger SOS">SOS</button>
    <button id="btn-recenter"  class="map-ctrl-btn" aria-label="Re-center map"      title="Re-center">🎯</button>
    <button id="btn-satellite" class="map-ctrl-btn" aria-label="Toggle satellite view" title="Satellite view">🛰️</button>
    <button id="btn-zoom-in"   class="map-ctrl-btn" aria-label="Zoom in"            title="Zoom in">+</button>
    <button id="btn-zoom-out"  class="map-ctrl-btn" aria-label="Zoom out"           title="Zoom out">−</button>
    <button id="btn-compass"   class="map-ctrl-btn" aria-label="Reset map rotation" title="Reset north">🧭</button>
  </div>

  <!-- ══════════════════════════════════════════════════
       BOTTOM SHEET (z-index: 700)
       ══════════════════════════════════════════════════ -->
  <aside id="bottom-sheet" aria-label="Ride information panel">

    <!-- Drag handle -->
    <div class="drag-handle-wrapper" role="slider" aria-label="Resize panel" aria-orientation="vertical">
      <div class="drag-handle"></div>
    </div>

    <!-- Tab bar -->
    <div class="tab-bar" role="tablist" aria-label="Ride sections">
      <button class="tab-btn active"
              data-target="tab-trip-plan"
              role="tab"
              id="tab-btn-trip"
              aria-selected="true"
              aria-controls="tab-trip-plan">
        🗺 Trip Plan
      </button>
      <button class="tab-btn"
              data-target="tab-members"
              role="tab"
              id="tab-btn-members"
              aria-selected="false"
              aria-controls="tab-members">
        👥 Members
      </button>
      <button class="tab-btn"
              data-target="tab-chat"
              role="tab"
              id="tab-btn-chat"
              aria-selected="false"
              aria-controls="tab-chat">
        💬 Chat
      </button>
    </div>

    <!-- ── TAB 1: TRIP PLAN ─────────────────────────────────────────── -->
    <div id="tab-trip-plan"
         class="tab-content active"
         role="tabpanel"
         aria-labelledby="tab-btn-trip">
      <div class="trip-plan-body">

        <!-- Route card -->
        <div class="trip-route-card">
          <div class="trip-route-row">
            <span class="trip-route-icon">📍</span>
            <div>
              <div class="trip-route-label">From</div>
              <!-- sorce is the real DB field name — DO NOT RENAME -->
              <div class="trip-route-value" title="<%= rideData.sorce %>"><%= rideData.sorce %></div>
            </div>
          </div>
          <div class="trip-route-row">
            <span class="trip-route-icon">🏁</span>
            <div>
              <div class="trip-route-label">To</div>
              <div class="trip-route-value" title="<%= rideData.destination %>"><%= rideData.destination %></div>
            </div>
          </div>
        </div>

        <!-- Ride info card -->
        <div class="trip-info-card">
          <div class="trip-info-row">
            <span class="trip-info-icon">👥</span>
            <span><%= rideData.members.length %> Member<%= rideData.members.length !== 1 ? 's' : '' %></span>
          </div>
          <div class="trip-info-row">
            <span class="trip-info-icon">📅</span>
            <span>
              <%
                const rideDate = new Date(rideData.date);
                const dateStr  = rideDate.toLocaleDateString('en-US', { weekday:'short', month:'short', day:'numeric' });
              %>
              <%= dateStr %> &nbsp;·&nbsp; <%= rideData.time %>
            </span>
          </div>
          <div class="trip-info-row">
            <span class="trip-info-icon">📏</span>
            <span><%= (rideData.distance / 1000).toFixed(1) %> km total</span>
          </div>
          <div class="trip-info-row">
            <span class="trip-info-icon">⚡</span>
            <!-- Status badge updated live via JS -->
            <span id="status-badge" class="status-badge status-<%= rideData.status %>">
              <%
                const statusMap = {
                  active:    '🟢 Active',
                  upcoming:  '🔵 Upcoming',
                  completed: '⬜ Completed',
                  canceled:  '🔴 Canceled',
                  cancelled: '🔴 Cancelled'
                };
              %>
              <%= statusMap[rideData.status] || rideData.status %>
            </span>
          </div>
        </div>

        <!-- Admin-only ride action buttons -->
         <% if(userid.toString() == rideData.adminId.toString()) { %>
        <div class="trip-actions" id="ride-action-buttons">
          <button id="btn-start-ride" aria-label="Start the ride">
            ▶ Start Ride
          </button>
          <button id="btn-end-ride" aria-label="End the ride">
            ⏹ End Ride
          </button>
        </div>
        <% } %>
      </div>
    </div>

    <!-- ── TAB 2: MEMBERS ───────────────────────────────────────────── -->
    <div id="tab-members"
         class="tab-content"
         role="tabpanel"
         aria-labelledby="tab-btn-members">
      <div id="members-list" aria-label="Ride members list">
        <!-- Rendered dynamically by renderMembersPanel() in map_page.js -->
        <div style="padding:24px 16px;color:#64748b;text-align:center;font-size:13px;">
          Loading members…
        </div>
      </div>
    </div>

    <!-- ── TAB 3: CHAT ──────────────────────────────────────────────── -->
    <div id="tab-chat"
         class="tab-content"
         role="tabpanel"
         aria-labelledby="tab-btn-chat"
         aria-live="polite">
      <div id="chat-messages" aria-label="Chat messages">
        <!-- History loaded by loadChatHistory() in map_page.js on page open -->
        <div class="chat-empty">No messages yet. Say hello! 👋</div>
      </div>
      <div class="chat-input-bar">
        <input
          id="chat-input"
          type="text"
          placeholder="Type a message…"
          autocomplete="off"
          maxlength="500"
          aria-label="Chat message input"
        />
        <button id="btn-send-chat" aria-label="Send message" title="Send">➤</button>
      </div>
    </div>

  </aside>

  <!-- ══════════════════════════════════════════════════
       RIDE ENDED OVERLAY (z-index: 2000)
       ══════════════════════════════════════════════════ -->
  <div id="ride-ended-overlay" role="dialog" aria-modal="true" aria-label="Ride completed">
    <div class="overlay-card">
      <div class="overlay-icon">🏁</div>
      <h2>Ride Completed!</h2>
      <p>You have reached your destination.<br />Thanks for riding with RideSync.</p>
      <button id="btn-back-to-rides" onclick="window.location.href='/ridesynk/<%= userid %>/rides'">
        Back to Rides
      </button>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════
       TOAST CONTAINER (z-index: 1100)
       ══════════════════════════════════════════════════ -->
  <div id="toast-container" role="status" aria-live="polite" aria-atomic="true"></div>

  <!-- ══════════════════════════════════════════════════
       NOTIFICATION STACK (z-index: 1100)
       Rich toast-style notifications for member events
       ══════════════════════════════════════════════════ -->
  <div id="notif-stack" aria-live="polite" aria-label="Ride notifications"></div>

  <div id="sos-overlay" class="sos-overlay" aria-hidden="true">
    <div class="sos-overlay-card">
      <h2>Send SOS?</h2>
      <p>Alert will be sent automatically in</p>
      <div id="sos-countdown" class="sos-countdown">5</div>
      <div id="sos-timestamp" style="font-size: 13px; color:#ef4444; margin-bottom: 14px; font-weight:700;"></div>
      <button id="sos-cancel-btn" type="button" class="sos-cancel-btn">Cancel</button>
    </div>
  </div>

  <div id="sos-alert-stack" class="sos-alert-stack" aria-live="polite" aria-label="SOS alerts"></div>

  <!-- Mapbox GL JS loaded above in <head> -->

  <!-- ══════════════════════════════════════════════════
       INJECT EJS SERVER VARIABLES INTO window.*
       All client JS reads from window.__ variables.
       CRITICAL: sorceLocation is GeoJSON — coordinates:[lng,lat]
       ══════════════════════════════════════════════════ -->
  <script>
    // ── Mapbox access token ──────────────────────────────
    window.__MAP_TOKEN__ = "<%= typeof map_token !== 'undefined' ? map_token : '' %>";

    // ── Currently logged-in user _id ─────────────────────
    window.__USERID__    = "<%= typeof userid !== 'undefined' ? userid : '' %>";

    // ── Full ride document serialized to JSON ─────────────
    // Fields exactly as in /models/ride.js:
    //   adminId, ridename, sorce, sorceLocation{type,coordinates:[lng,lat]},
    //   destination, destinationLocation, status, totalMembers, distance, date, time
    // members is populated array of user objects from ride_member join (server populates)
    <% 
      const safeRideData = {
        _id:                 rideData._id,
        adminId:             rideData.adminId,
        ridename:            rideData.ridename,
        sorce:               rideData.sorce,
        sorceLocation:       rideData.sorceLocation,
        destination:         rideData.destination,
        destinationLocation: rideData.destinationLocation,
        status:              rideData.status,
        totalMembers:        rideData.totalMembers,
        distance:            rideData.distance,
        date:                rideData.date,
        time:                rideData.time,
        members:             rideData.members
      };
    %>
    window.__RIDE_DATA__ = <%- JSON.stringify(safeRideData).replace(/</g, '\\u003c') %>;
  </script>

  <!-- ══════════════════════════════════════════════════
       MAIN CLIENT MODULE (ES module — imports socket.js)
       ══════════════════════════════════════════════════ -->
  <script type="module" src="/js/map_page.js"></script>

</body>
</html>
