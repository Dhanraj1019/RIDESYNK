<% layout("/layout/boilerplate.ejs") %>

<script>
  map_token='<%=map_token%>';
</script>

<body>
<div class="page">

  <!-- Header -->
  <div class="header-row">
      <a href="/ridesynk/home">
        <button class="back-btn" aria-label="Go back">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>
      </a>
    <div style="flex:1">
      <p class="header-title">
        <%= data.ridename %>
      </p>
      <p class="header-sub">
        <%
          const headerRideDate = new Date(data.date);
          const nowDate = new Date();
          const isTodayRide =
            headerRideDate.getFullYear() === nowDate.getFullYear() &&
            headerRideDate.getMonth() === nowDate.getMonth() &&
            headerRideDate.getDate() === nowDate.getDate();
          const headerDateLabel = isTodayRide
            ? "Today"
            : headerRideDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        %>
        <%= headerDateLabel + ", " + data.time + " . " + members.length + " riders " %>
      </p>
    </div>
  </div>

  <!-- Route Summary -->
  <% const isRideAdmin = curruser && data && data.adminId && data.adminId.toString() === curruser._id.toString(); %>
  <div class="route-card" id="routeCard" data-rideid="<%= data._id %>" data-currentuserid="<%= curruser ? curruser._id : '' %>">
    <% if (isRideAdmin) { %>
      <button class="route-edit-btn" id="routeEditBtn" type="button" aria-label="Edit ride details">
        <i class="bi bi-pencil-square"></i>
      </button>
    <% } %>

    <div class="route-view-mode" id="routeViewMode">
      <div class="route-pin">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
        </svg>
        <span id="sourceText"><%= data.sorce %></span>
      </div>

        <div class="route-pin" style="margin-top:0.75rem">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
        </svg>
        <span id="destinationText"><%= data.destination %></span>
      </div>

      <div class="route-meta-row">
        <div class="route-meta-chip">
          <span class="route-meta-label">Date</span>
          <span class="route-meta-value" id="rideDateText"><%= new Date(data.date).toLocaleDateString('en-CA') %></span>
        </div>
        <div class="route-meta-chip">
          <span class="route-meta-label">Time</span>
          <span class="route-meta-value" id="rideTimeText"><%= data.time %></span>
        </div>
      </div>
    </div>

    <% if (isRideAdmin) { %>
      <!-- Dynamic stops -->
        <div id="stops-container"></div>
        
      <div class="route-edit-mode d-none" id="routeEditMode">
        <div class="route-input-wrap">
          <label for="sourceInput" class="route-input-label">Source</label>
          <input
            id="sourceInput"
            class="route-input"
            type="text"
            value="<%= data.sorce %>"
            data-lat="<%= data.sorceLocation && data.sorceLocation.coordinates ? data.sorceLocation.coordinates[1] : '' %>"
            data-lng="<%= data.sorceLocation && data.sorceLocation.coordinates ? data.sorceLocation.coordinates[0] : '' %>"
            autocomplete="off"
          />
        </div>

        <div class="route-input-wrap">
          <label for="destinationInput" class="route-input-label">Destination</label>
          <input
            id="destinationInput"
            class="route-input"
            type="text"
            value="<%= data.destination %>"
            data-lat="<%= data.destinationLocation && data.destinationLocation.coordinates ? data.destinationLocation.coordinates[1] : '' %>"
            data-lng="<%= data.destinationLocation && data.destinationLocation.coordinates ? data.destinationLocation.coordinates[0] : '' %>"
            autocomplete="off"
          />
        </div>

        <div class="route-edit-grid">
          <div class="route-input-wrap">
            <label for="rideDateInput" class="route-input-label">Date</label>
            <input
              id="rideDateInput"
              class="route-input"
              type="date"
              value="<%= new Date(data.date).toLocaleDateString('en-CA') %>"
            />
          </div>

          <div class="route-input-wrap">
            <label for="rideTimeInput" class="route-input-label">Time</label>
            <input
              id="rideTimeInput"
              class="route-input"
              type="time"
              value="<%= data.time %>"
            />
          </div>
        </div>

        <p class="route-edit-error d-none" id="routeEditError" aria-live="polite"></p>

        <div class="route-edit-actions">
          <button class="route-btn route-btn-cancel" id="routeCancelBtn" type="button">
            <i class="bi bi-x-circle"></i>
            Cancel
          </button>
          <button class="route-btn route-btn-save" id="routeSaveBtn" type="button">
            <i class="bi bi-check-circle"></i>
            Save
          </button>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Actions -->
  <div class="actions-grid">
    <button class="action-btn action-primary js-track-live" onclick="window.location.href='/ridesynk/rideroom/<%= data._id %>/live-tracking'" type="button">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="5 3 19 12 5 21 5 3"/>
      </svg>
      LIVE TRACKING
    </button>
    <button class="action-btn action-default" onclick="window.location.href='/ridesynk/rideroom/<%= data._id %>/add-members'">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
        <circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/>
      </svg>
      Add
    </button>
    <button
      class="action-btn action-default"
      id="rideRoomSosBtn"
      type="button"
      data-rideid="<%= data._id %>"
      data-soslogurl="/ridesynk/rideroom/<%= data._id %>/sos"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
        <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
      </svg>
      SOS
    </button>
    <button class="action-btn action-default" id="shareRideBtn" data-rideid="<%= data._id %>" <%= isRideAdmin ? '' : 'disabled' %>>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="18" cy="5" r="3"/>
        <circle cx="6" cy="12" r="3"/>
        <circle cx="18" cy="19" r="3"/>
        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
      </svg>
      Share Ride
    </button>
  </div>

  <div class="share-container" id="shareContainer" aria-hidden="true">
    <div class="share-card" role="dialog" aria-label="Share this ride">
      <div class="share-head">
        <h3>Share this ride</h3>
        <button type="button" class="share-close" id="shareCloseBtn" aria-label="Close share card">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>

      <div class="share-link-row">
        <input type="text" id="inviteLinkInput" readonly placeholder="Generate invite link" />
        <button type="button" class="share-mini-btn" id="copyInviteLinkBtn">
          <i class="bi bi-clipboard"></i>
          Copy
        </button>
      </div>

      <div class="share-actions">
        <button type="button" class="share-primary-btn" id="shareCopyPrimaryBtn">Copy Link</button>
        <button type="button" class="share-secondary-btn" id="nativeShareBtn" style="display:none;">Share</button>
      </div>

      <p class="share-feedback" id="shareFeedback" aria-live="polite"></p>
    </div>
  </div>

  <!-- <div class="ride_link mb-2" style="display: flex; justify-content: space-between;">
    <div class="linkfield">
      <input type="text" id="rideLinkInput" value="http://localhost:8080/ridesynk/rideroom/add-member/link/<%=data._id%>" readonly />
      <button class="copy-btn" id="copyRideLinkBtn" onclick="copyRideLink()">
        <i class="bi bi-clipboard"></i>
    </div>
    <button>
      Join Ride
    </button>
  </div> -->
  <!-- Members -->
  <div class="section-header">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
      fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
      <circle cx="9" cy="7" r="4"/>
      <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
    </svg>
    Members
  </div>

  <div class="members-list" id="members-list">
    <% members.forEach((member, i) => { %>
      <div class="member-card">
        <div class="member-avatar">
          <%=member.userId.firstname && member.userId.lastname && member.userId.firstname.length>1 && member.userId.lastname.length>1 ? member.userId.firstname[0].toUpperCase() + member.userId.lastname[0].toUpperCase() : member.userId.username[0].toUpperCase() %>
        </div>
        <div style="flex:1">
          <p class="member-name">
            <%= member.userId.firstname && member.userId.lastname && member.userId.firstname.length>1 && member.userId.lastname.length>1 ? member.userId.firstname + " " + member.userId.lastname : member.userId.username%>
          </p>
          <p class="member-sub">
            <%= "+91 " + member.userId.phonenumber %>
          </p>
        </div>
      </div>
    <% }) %>
  </div>

  <div id="sosOverlay" class="sos-overlay" aria-hidden="true">
    <div class="sos-overlay-card">
      <h2>Sending SOS...</h2>
      <p>Alert will be sent automatically in</p>
      <div id="sosCountdown" class="sos-countdown">5</div>
      <button id="sosCancelBtn" type="button" class="sos-cancel-btn">Cancel</button>
    </div>
  </div>
  
</div>

<script src="/js/ride_room.js"></script>
</body>

 
