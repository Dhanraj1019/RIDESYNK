<% layout("/layout/boilerplate.ejs") %>
 <script>
    map_token='<%=map_token%>';
 </script>
<body>
<div class="page">

  <!-- Header -->
  <div class="header-row">
    <button class="back-btn" onclick="history.back()" aria-label="Go back">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>
    <h1 class="page-title">Create Ride</h1>
  </div>

  <!-- Form -->
  <div class="form-body">
    <form method="post" class="needs-validation" novalidate action="/ridesynk/ride/createride">

      <!-- Ride Name -->
      <div>
        <label class="field-label" for="ride-name">Ride Name</label>
        <input class="field-input form-control" required type="text" name="ride[ridename]" id="ride-name" placeholder="e.g. Weekend Coastal Run" />
      </div>
  
      <!-- Date & Time -->
      <div class="two-col">
        <div>
          <label class="field-label" for="ride-date">Date</label>
          <input class="field-input form-control" required name="ride[date]" type="date" id="ride-date" />
        </div>
        <div>
          <label class="field-label" for="ride-time">Time</label>
          <input class="field-input form-control" required name="ride[time]" type="time" id="ride-time" />
        </div>
      </div>
      <p id="error-msg" class="error" aria-live="polite"></p>
  
      <!-- Route -->
      <div>
        <label class="field-label">Route</label>
        <div style="display:flex;flex-direction:column;gap:0.75rem">
  
          <!-- Start -->
          <div class="route-row">
            <div class="pin-dot">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <input class="field-input form-control" required type="text" name="ride[sorce]" placeholder="Start Location" />
          </div>
  
          <!-- Dynamic stops -->
          <div id="stops-container"></div>
  
          <!-- Add Stop button (hidden when 3 stops reached) -->
          <button class="add-stop-btn" id="add-stop-btn" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Add Stop
          </button>
  
          <!-- Destination -->
          <div class="route-row">
            <div class="pin-dot">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <input class="field-input form-control" type="text" required name="ride[destination]" placeholder="Destination" />
          </div>
  
        </div>
      </div>
  
      <!-- Submit -->
      <button type="submit" class="btn-primary-custom" id="create-btn">Create Ride</button>
    </form>
  </div>
</div>

</body>




