<% layout("/layout/boilerplate.ejs") %>
<body>
  <!-- ── Top Nav ─────────────────────────────────── -->
  <div class="top-nav">
    <div class="d-flex align-items-center gap-2">
      <a href="#" class="nav-icon-btn"><i class="bi bi-arrow-left"></i></a>
      <h1>My Rides</h1>
    </div>
    <div class="d-flex align-items-center gap-2">
      <button class="nav-icon-btn" id="filterBtn" title="Filter"><i class="bi bi-sliders"></i></button>
    </div>
  </div>
 
  <!-- ── Main Content ────────────────────────────── -->
  <div class="container-fluid px-3 pt-3 " style="max-width:520px; margin:0 auto;">
 
    <!-- Search -->
    <div class="search-wrap mb-3">
      <i class="bi bi-search"></i>
      <input class="search-input" id="searchInput" type="text" placeholder="Search rides…" autocomplete="off"/>
    </div>
 
    <!-- Tab Switcher -->
    <div class="tab-switcher mb-4" id="tabSwitcher">
      <button class="tab-item active" data-tab="all">
        All <span class="count-chip" id="upcomingCount">0</span>
      </button>
      <button class="tab-item " data-tab="upcoming">
        Upcoming <span class="count-chip" id="upcomingCount">0</span>
      </button>
      <button class="tab-item" data-tab="completed">
        Completed <span class="count-chip" id="completedCount">0</span>
      </button>
    </div>
 
  </div>
    <!-- ── UPCOMING TAB ─────────────────────────── -->
    <div class="tab-content-pane active" id="pane-upcoming">
      <!-- <div class="section-label mb-2">This Week</div> -->
      <% for(let rides of data) { %>
        <div class="d-flex flex-column gap-2" id="upcoming-this-week">
          <a href="/ridesync/rideroom/<%=rides.rideId._id%>" class="mb-2 ride-card" data-id="${ride.id}" data-name="${ride.name.toLowerCase()}">
            <div class="card-icon ${isCompleted ? 'completed' : ''}">
              <i class="bi bi-geo-alt-fill"></i>
            </div>
            <div class="card-body-inner">
              <div class="card-title">
                <%= rides.rideId.ridename %>
              </div>
              <div class="card-meta">
                <span>
                  <%= new Date(rides.rideId.date).toLocaleString('en-IN', {
                    weekday: 'short',
                    day: 'numeric',
                    month: 'short',
                    hour: '2-digit',
                    minute: '2-digit'
                  }) %>
                </span>
                <span class="dot"></span>
                <span><%= rides.rideId.totalMembers + "riders" %></span>
                <span class="dot"></span>
                <span>5Km</span>
              </div>
              <div class="mt-1">
                <span class="ride-badge ${isCompleted ? 'badge-completed' : 'badge-upcoming'}">
                  <span class="badge-dot"></span>
                  Upcoming
                </span>
              </div>
            </div>
            <i class="bi bi-chevron-right card-chevron"></i>
          </a>
        </div>
      <% } %>
      <div class="no-result d-none" id="upcoming-no-result">No upcoming rides found</div>
    </div>
 
    <!-- ── COMPLETED TAB ─────────────────────────── -->
    <!-- <div class="tab-content-pane" id="pane-completed">
      <div class="section-label mb-2">Recent</div>
      <div class="d-flex flex-column gap-2" id="completed-list"></div>
      <div class="no-result d-none" id="completed-no-result">No completed rides found</div>
    </div> -->
 
 
  <script src="/js/ride_list.js"></script>
</body>

