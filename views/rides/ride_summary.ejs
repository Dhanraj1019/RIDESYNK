<% layout("/layout/boilerplate.ejs") %>
  
<body>
<div class="page">

  <!-- Header -->
  <div class="header-row">
    <button class="back-btn" onclick="history.back()" aria-label="Go back">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>
    <h1 class="page-title">Ride Summary</h1>
  </div>

  <!-- Ride title card -->
  <div class="card title-card">
    <h2>Weekend Coastal Run</h2>
    <p>Feb 23, 2026 · Completed</p>
  </div>

  <!-- Stats grid -->
  <div class="stats-grid">

    <!-- Distance -->
    <div class="card stat-card" style="animation-delay:0s">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="6" cy="19" r="3"/><circle cx="18" cy="5" r="3"/>
        <path d="M12 19h4.5a3.5 3.5 0 0 0 0-7h-8a3.5 3.5 0 0 1 0-7H12"/>
      </svg>
      <p class="stat-value">98 km</p>
      <p class="stat-label">Distance</p>
    </div>

    <!-- Duration -->
    <div class="card stat-card" style="animation-delay:0.05s">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
      </svg>
      <p class="stat-value">2h 45m</p>
      <p class="stat-label">Duration</p>
    </div>

    <!-- Riders -->
    <div class="card stat-card" style="animation-delay:0.1s">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
      </svg>
      <p class="stat-value">4</p>
      <p class="stat-label">Riders</p>
    </div>

    <!-- Stops -->
    <div class="card stat-card" style="animation-delay:0.15s">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
      </svg>
      <p class="stat-value">2</p>
      <p class="stat-label">Stops</p>
    </div>

  </div>

  <!-- Route card -->
  <div class="card route-card">
    <h3>Route Completed</h3>
    <div class="route-points">
      <div class="route-point">
        <div class="point-dot dot-start"></div>
        <p class="point-name">Marine Drive</p>
        <span class="point-time">6:00 AM</span>
      </div>
      <div class="route-point">
        <div class="point-dot dot-stop"></div>
        <p class="point-name">Highway Junction</p>
        <span class="point-time">6:45 AM</span>
      </div>
      <div class="route-point">
        <div class="point-dot dot-stop"></div>
        <p class="point-name">Beachside Café</p>
        <span class="point-time">7:30 AM</span>
      </div>
      <div class="route-point">
        <div class="point-dot dot-end"></div>
        <p class="point-name">Sunset Point</p>
        <span class="point-time">8:45 AM</span>
      </div>
    </div>
  </div>

  <!-- Back to Home -->
  <button class="btn-primary-custom" onclick="window.location.href='/ridesynk/home'">
    Back to Home
  </button>

</div>
</body>
