  <!-- Sign Out Confirm -->
  <div class="modal fade" id="signoutModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title">Sign Out?</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body pt-1" style="color:var(--muted);font-size:.9rem;">
          You'll need to log in again to use Ridesynk.
        </div>
        <div class="modal-footer">
          <button class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
          <form action="/ridesynk/entry/logout" method="get">
            <button class="btn-brand btn" type="submit">Sign Out</button>
          </form>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Delete Account -->
  <div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title" style="color:var(--danger)"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Account</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body pt-1">
          <div class="delete-warning-box">
        <div class="warn-icon">
          ⚠️
        </div>

        <div class="warn-content">
          <h4 class="warn-title">Delete Your Account?</h4>

          <p class="warn-text">
            If you proceed, your account will be <strong>deactivated immediately</strong>.
          </p>

          <div class="warn-section">
            <p class="warn-heading">What happens next:</p>
            <ul class="warn-list">
              <li>Your profile will no longer be active or visible for interactions.</li>
              <li>Other users may still see your account in search, but they <strong>cannot add you to rides</strong>.</li>
              <li>Your account will be <strong>permanently deleted after 30 days</strong>.</li>
            </ul>
          </div>

          <div class="warn-section">
            <p class="warn-heading">Can you recover your account?</p>
            <p class="warn-sub">
              Yes. If you log in within <strong>30 days</strong>, your account will be fully restored with all your data.
            </p>
            <p class="warn-sub">
              After 30 days, your account and all associated data will be <strong>permanently removed and cannot be recovered</strong>.
            </p>
          </div>

          <p class="warn-final">
            ⚠️ This action will restrict your access until you log in again.
          </p>

          <p class="warn-confirm">
            Are you sure you want to continue?
          </p>
        </div>
      </div>
          <label class="form-label">Type <strong>DELETE</strong> to confirm</label>
          <input type="text" class="form-control" id="deleteConfirmInput" placeholder="DELETE">
        </div>
        <div class="modal-footer">
          <button class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
          <form action="/ridesynk/user/<%=data._id%>/delete?_method=DELETE" method="POST">
            <button class="btn-danger-soft btn" id="confirmDeleteBtn" disabled onclick="showToast('Account deleted')">Delete Permanently</button>
          </form>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Toast -->
  <div class="toast-container">
    <div id="appToast" class="toast toast-success align-items-center" role="alert" aria-live="assertive">
      <div class="d-flex">
        <div class="toast-body d-flex align-items-center gap-2">
          <i class="bi bi-check-circle-fill" style="color:var(--success)"></i>
          <span id="toastMsg">Done!</span>
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
      </div>
    </div>
  </div>

  <script>
    window.settingsProfileData = {
      username: "<%= data.username || '' %>",
      firstname: "<%= data.firstname || '' %>",
      lastname: "<%= data.lastname || '' %>",
      email: "<%= data.email || '' %>",
      phonenumber: "<%= data.phonenumber || '' %>",
      vehical: "<%= data.vehical || '' %>",
      updateAction: "/ridesynk/user/update?_method=PATCH"
    };
  </script>
  <script src="/js/settings.js"></script>
  <script src="/js/ProfileViewModal.js"></script>
  <script src="/js/EditProfileModal.js"></script>
</body>
