<% layout("/layout/boilerplate.ejs") %>
  
<body>
<div class="app-shell">
  <div class="inner">

    <!-- Logo -->
    <div class="logo-wrap">
      <!-- Swap for: <img src="/RideSynk.jpeg" alt="RideSynk"> -->
      <div class="logo-placeholder">RS</div>
    </div>

    <!-- Heading -->
    <div class="heading-block">
      <h1 id="heading-title">Create Account</h1>
      <p id="heading-sub">Join Ridesynk and coordinate your group rides.</p>
    </div>

    <!-- Form -->
    <form id="auth-form" class="needs-validation signupform" method="post" action="/ridesync/signup" novalidate>
      <div>
        <label class="field-label" for="email">Email</label>
        <div class="input-wrap">
          <input class="field-input form-control" type="email" class="email" id="email" name="user[email]" placeholder="you@email.com" required />
          <div class="invalid-feedback">
            Please enter Email..
          </div>
          <div class="valid-feedback">
            Looks good!
          </div>
          <!-- Check icon (shown when verified) -->
          <span id="username-check" class="input-icon check-icon hidden">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </span>
        </div>
        <!-- Verify link (signup only, before verified) -->
        <button type="button" id="verify-btn" class="verify-link hidden">Verify Email</button>
      </div>
 

      <div>
        <label class="field-label" for="username">Username</label>
        <div class="input-wrap">
          <input class="field-input form-control" class="username" type="text" id="username" name="user[username]" placeholder="enter your username" required />
          <div class="invalid-feedback">
            Please enter a username.
          </div>
          <div class="valid-feedback">
            Looks good!
          </div>
          <!-- Check icon (shown when verified) -->
          <span id="email-check" class="input-icon check-icon hidden">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </span>
        </div>

        
      <!-- <div>
        <label class="field-label" for="lastname">Last Name</label>
        <div class="input-wrap">
          <input class="field-input" type="text" id="lastname" name="user[lastname]" placeholder="enter your firstname" required />
           Check icon (shown when verified) 
          <span id="email-check" class="input-icon check-icon hidden">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </span>
        </div> -->


        <!-- Verify link (signup only, before verified) -->
        <!-- <button type="button" id="verify-btn" class="verify-link hidden">Verify Email</button> -->
      <!-- </div> -->
 
      <!-- Password -->
      <div>
  <label class="field-label" for="password">Password</label>

  <div class="input-wrap position-relative">
    <input class="field-input password1 form-control" type="password" id="password" name="password" placeholder="••••••••" required minlength="6"/>
    <div class="invalid-feedback">
      Please enter a Password.
    </div>
    <div class="valid-feedback">
      Looks good!
    </div>
    <!-- <button type="button" class="input-icon position-absolute end-5 top-40 translate-middle-y border-0 bg-transparent" id="toggle-pw">
      <i id="icon-eye" class="fa fa-eye"></i>
      <i id="icon-eye-off" class="fa fa-eye-slash d-none"></i>
    </button> -->
  </div>
  <label class="field-label" for="password">Reenter Password</label>
  <div class="input-wrap position-relative">
    <input class="field-input password2 form-control" type="password" id="password" placeholder="••••••••" required minlength="6"/>
    <div class="invalid-feedback">
      Please enter a Password.
    </div>
    <div class="valid-feedback">
      Looks good!
    </div>
    <!-- <button type="button" class="input-icon position-absolute end-5 top-40 translate-middle-y border-0 bg-transparent" id="toggle-pw">
      <i id="icon-eye" class="fa fa-eye"></i>
      <i id="icon-eye-off" class="fa fa-eye-slash d-none"></i>
    </button> -->
  </div>
  <div id="pass-error" class="pass-error hidden">
    ⚠ Passwords do not match
  </div>
  </div>
      <button type="submit" class="btn-primary-custom signupbtn" id="submit-btn">Sign Up</button>
    </form>

    <!-- Toggle row -->
    <p class="toggle-row">
      <span id="toggle-label">Do have an account?</span>
      <a class="loginanchor" href="/ridesync/login">Login</a>
    </p>

  </div>
</div>

<script src="/js/signup.js"></script>

</body>
