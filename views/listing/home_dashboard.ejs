5.653,45.277,100.93,100.93,100.93 s100.93-45.277,100.93-100.93C330.772,118.986,285.494,73.71,229.842,73.71z M229.842,248.277 c-40.604,0-73.639-33.034-73.639-73.639S189.237,101,229.842,101c40.605,0,73.639,33.034,73.639,73.638 S270.446,248.277,229.842,248.277z"></path> </g> </g> </g> </g></svg>        
        <p class="stat-value">0</p><p class="stat-label"> Badges </p>
      </div>
    </div>

    <div class="section-header">
      <h2>Your Rides</h2>
      <button class="view-all-btn" onclick="window.location.href='/ridesynk/<%= data._id %>/rides'">View All</button>
    </div>

    <%
      const sortedRides = (rides || [])
        .filter((item) => item && item.rideId)
        .slice()
        .sort((a, b) => {
          const aDate = new Date(a.rideId.date || 0).getTime();
          const bDate = new Date(b.rideId.date || 0).getTime();
          return bDate - aDate;
        });
    %>

  <% sortedRides.forEach((ride, i) => { %>
    <%
      const rawStatus = String(ride.rideId.status || '').trim().toLowerCase();
      const canonicalStatus = rawStatus === 'cancelled' ? 'canceled' : rawStatus;
      const safeStatus = canonicalStatus || 'upcoming';
    %>
    
    <button class="ride-card mb-1" onclick="window.location.href='/ridesynk/rideroom/<%= ride.rideId._id %>'">

      <div class="ride-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
      </div>

      <div class="ride-info">
        <p class="ride-name"><%= ride.rideId.ridename %></p>
        <p class="ride-meta">
          <%= new Date(ride.rideId.date).toDateString() + " . " + ride.rideId.totalMembers + " riders" %>
        </p>
        <span class="ride-status-badge ride-status-<%= safeStatus %>"><%= safeStatus %></span>
      </div>

      <svg class="chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16"
        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"/>
      </svg>

    </button>

    <% }) %>

</div>
    </div>
  </div>

  <!-- FAB -->
  <button style="border: none;" class=" plusbtn" onclick="window.location.href='/ridesynk/ride/createride'" aria-label="Create new ride">
    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
  </button>

  <!-- Drawer -->
  <div class="drawer-overlay" id="drawer-overlay"></div>
  <div class="drawer" id="profile-drawer" role="dialog" aria-label="Profile">
    <div class="drawer-header">
      <p class="drawer-title">Profile</p>
      <button id="close-drawer">✕</button>
    </div>
    <div class="drawer-content">
      <div class="drawer-profile">
        <div class="drawer-avatar" id="drawer-avatar">
          <%= getInitials(data) %>
        </div>
        <p class="drawer-name" id="drawer-name">
          <%= getFullName(data) %>
        </p>
        <div class="drawer-role">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Member</span>
        </div>
        <p class="drawer-email" id="drawer-email">
          <%= data.email || 'No email provided' %>
        </p>
      </div>
      <!-- <div class="stat-mini-grid">
        <div class="stat-mini"><p class="stat-mini-val">
          <%= rides.length %>
        </p><p class="stat-mini-lbl">Rides</p></div>
        <div class="stat-mini"><p class="stat-mini-val">3.8k</p><p class="stat-mini-lbl">km</p></div>
        <div class="stat-mini"><p class="stat-mini-val">
          <%= members %>
        </p><p class="stat-mini-lbl">Total Members</p></div>
      </div> -->
      <div class="drawer-info-list">
        <div class="info-row"><p class="info-row-label">Vehical</p><p class="info-row-val" id="drawer-bike">
          <%= data.vehical || "..." %>
        </p></div>
        <div class="info-row"><p class="info-row-label">Phone</p><p class="info-row-val" id="drawer-phone">
          <%= data.phonenumber || "..." %>
        </p></div>
      </div>
      <button class="btn-primary-custom" onclick="window.location.href='/ridesynk/profile'">View Full Profile</button>
      <div class="adjstdrawer" style="height: 3rem;width: 100%;"></div>
    </div>
  </div>
  <!-- <script src="/js/home_dashboard.js"></script> -->
</body>