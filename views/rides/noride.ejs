<%- layout("/layout/boilerplate.ejs") %>

<body>
<div class="page">

  <!-- HEADER -->
  <div class="hdr">
    <div class="hdr-l">
      <a class="back" onclick="history.back()"><i class="fa-solid fa-arrow-left" style="font-size:.78rem;"></i></a>
      <div>
        <div class="hdr-title">My Rides</div>
        <div class="hdr-sub">Your ride rooms live here</div>
      </div>
    </div>
    <a class="new-btn" href="/ridesynk/createride">
      <i class="fa-solid fa-plus" style="font-size:.72rem;"></i>New Ride
    </a>
  </div>



  <!-- EMPTY STATE -->
  <div class="empty">

    <div class="illus-box">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="blob blob-3"></div>
      <span class="sp" style="top:8px;right:52px;animation-delay:.3s;">✦</span>
      <span class="sp" style="top:62px;left:12px;animation-delay:1.1s;font-size:.6rem;">✦</span>
      <span class="sp" style="bottom:28px;right:18px;animation-delay:1.8s;font-size:.65rem;">✦</span>
      <span class="sp" style="bottom:55px;left:26px;animation-delay:.7s;font-size:.5rem;">✦</span>

      <!-- ══════════════ BRIGHT DAY SVG ══════════════ -->
      <svg class="illus" viewBox="0 0 290 240" fill="none" xmlns="http://www.w3.org/2000/svg">

        <!-- SKY — bright blue gradient -->
        <defs>
          <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%"   stop-color="#87ceeb"/>
            <stop offset="100%" stop-color="#c9e8f8"/>
          </linearGradient>
          <linearGradient id="road" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%"   stop-color="#c8ccd8"/>
            <stop offset="100%" stop-color="#b0b4c4"/>
          </linearGradient>
          <linearGradient id="grass" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%"   stop-color="#a8d878"/>
            <stop offset="100%" stop-color="#88c050"/>
          </linearGradient>
          <radialGradient id="sunGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%"   stop-color="#fff176" stop-opacity=".9"/>
            <stop offset="100%" stop-color="#ffd740" stop-opacity="0"/>
          </radialGradient>
          <linearGradient id="hmist" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%"   stop-color="#c9e8f8" stop-opacity=".6"/>
            <stop offset="100%" stop-color="#c9e8f8" stop-opacity="0"/>
          </linearGradient>
        </defs>

        <rect width="290" height="240" rx="28" fill="url(#sky)"/>

        <!-- SUN -->
        <circle cx="228" cy="42" r="30" fill="url(#sunGlow)"/>
        <circle cx="228" cy="42" r="20" fill="#ffe066" opacity=".95"/>
        <circle cx="228" cy="42" r="14" fill="#ffd740"/>
        <!-- sun rays -->
        <line x1="228" y1="16" x2="228" y2="10" stroke="#ffd740" stroke-width="2.5" stroke-linecap="round" opacity=".7"/>
        <line x1="228" y1="68" x2="228" y2="74" stroke="#ffd740" stroke-width="2.5" stroke-linecap="round" opacity=".7"/>
        <line x1="202" y1="42" x2="196" y2="42" stroke="#ffd740" stroke-width="2.5" stroke-linecap="round" opacity=".7"/>
        <line x1="254" y1="42" x2="260" y2="42" stroke="#ffd740" stroke-width="2.5" stroke-linecap="round" opacity=".7"/>
        <line x1="210" y1="24" x2="206" y2="20" stroke="#ffd740" stroke-width="2" stroke-linecap="round" opacity=".6"/>
        <line x1="246" y1="60" x2="250" y2="64" stroke="#ffd740" stroke-width="2" stroke-linecap="round" opacity=".6"/>
        <line x1="246" y1="24" x2="250" y2="20" stroke="#ffd740" stroke-width="2" stroke-linecap="round" opacity=".6"/>
        <line x1="210" y1="60" x2="206" y2="64" stroke="#ffd740" stroke-width="2" stroke-linecap="round" opacity=".6"/>

        <!-- CLOUDS -->
        <!-- cloud 1 -->
        <ellipse cx="60"  cy="48" rx="32" ry="14" fill="white" opacity=".95"/>
        <ellipse cx="42"  cy="52" rx="20" ry="12" fill="white" opacity=".95"/>
        <ellipse cx="78"  cy="52" rx="22" ry="12" fill="white" opacity=".95"/>
        <ellipse cx="60"  cy="44" rx="20" ry="12" fill="white"/>
        <!-- cloud shadow -->
        <ellipse cx="60"  cy="62" rx="30" ry="5"  fill="rgba(150,180,220,.15)"/>

        <!-- cloud 2 -->
        <ellipse cx="155" cy="30" rx="24" ry="11" fill="white" opacity=".9"/>
        <ellipse cx="139" cy="34" rx="16" ry="9"  fill="white" opacity=".9"/>
        <ellipse cx="170" cy="34" rx="17" ry="9"  fill="white" opacity=".9"/>
        <ellipse cx="155" cy="26" rx="16" ry="10" fill="white" opacity=".9"/>

        <!-- DISTANT HILLS -->
        <path d="M0 138 Q50 108 100 124 Q135 108 170 126 Q205 108 245 124 Q265 112 290 120 L290 165 L0 165Z"
              fill="#c8e89a"/>
        <path d="M0 148 Q60 128 118 142 Q155 128 195 144 Q235 128 290 144 L290 165 L0 165Z"
              fill="#b4de80"/>

        <!-- TREES left -->
        <rect x="46" y="128" width="6"  height="32" rx="3" fill="#8b6f47"/>
        <ellipse cx="49" cy="118" rx="20" ry="24" fill="#5cb85c" opacity=".9"/>
        <ellipse cx="49" cy="113" rx="14" ry="17" fill="#4caf50"/>
        <ellipse cx="49" cy="108" rx="9"  ry="11" fill="#66bb6a"/>

        <rect x="30" y="136" width="5"  height="24" rx="2.5" fill="#8b6f47"/>
        <ellipse cx="32" cy="128" rx="15" ry="18" fill="#5cb85c" opacity=".85"/>
        <ellipse cx="32" cy="124" rx="10" ry="13" fill="#4caf50"/>

        <!-- TREES right -->
        <rect x="238" y="124" width="6"  height="36" rx="3" fill="#8b6f47"/>
        <ellipse cx="241" cy="114" rx="22" ry="26" fill="#5cb85c" opacity=".9"/>
        <ellipse cx="241" cy="108" rx="15" ry="18" fill="#4caf50"/>
        <ellipse cx="241" cy="103" rx="10" ry="12" fill="#66bb6a"/>

        <rect x="257" y="132" width="5"  height="28" rx="2.5" fill="#8b6f47"/>
        <ellipse cx="259" cy="122" rx="16" ry="19" fill="#5cb85c" opacity=".85"/>
        <ellipse cx="259" cy="118" rx="11" ry="13" fill="#4caf50"/>

        <!-- GROUND / GRASS -->
        <path d="M0 165 L290 165 L290 240 L0 240Z" fill="url(#grass)"/>

        <!-- ROAD -->
        <path d="M0 182 L88 160 L202 160 L290 182 L290 240 L0 240Z" fill="url(#road)"/>
        <!-- road shoulders -->
        <path d="M88 160 L0 182"  stroke="#a8acbc" stroke-width="2.5"/>
        <path d="M202 160 L290 182" stroke="#a8acbc" stroke-width="2.5"/>
        <!-- white side lines -->
        <path d="M84 160 L0 184"  stroke="white" stroke-width="1.5" opacity=".6"/>
        <path d="M206 160 L290 184" stroke="white" stroke-width="1.5" opacity=".6"/>

        <!-- LANE DASHES (perspective) -->
        <rect x="137" y="164" width="16" height="5"  rx="2.5" fill="white" opacity=".75"/>
        <rect x="130" y="176" width="30" height="5"  rx="2.5" fill="white" opacity=".65"/>
        <rect x="119" y="191" width="52" height="6"  rx="3"   fill="white" opacity=".55"/>
        <rect x="105" y="208" width="80" height="6"  rx="3"   fill="white" opacity=".45"/>
        <rect x="83"  y="228" width="124" height="7" rx="3.5" fill="white" opacity=".35"/>

        <!-- horizon mist -->
        <path d="M0 160 L290 160 L290 170 L0 170Z" fill="url(#hmist)"/>

        <!-- FLOWERS on grass -->
        <circle cx="20"  cy="175" r="3" fill="#ff8fab"/>
        <circle cx="20"  cy="175" r="1.5" fill="#ffe0a0"/>
        <circle cx="268" cy="172" r="3" fill="#ffb347"/>
        <circle cx="268" cy="172" r="1.5" fill="#fff3b0"/>
        <circle cx="75"  cy="170" r="2.5" fill="#ff8fab"/>
        <circle cx="75"  cy="170" r="1.2" fill="white"/>
        <circle cx="215" cy="168" r="2.5" fill="#b39ddb"/>
        <circle cx="215" cy="168" r="1.2" fill="white"/>

        <!-- ROAD SIGN left -->
        <rect x="62" y="136" width="4" height="28" rx="2" fill="#9e9e9e"/>
        <rect x="54" y="128" width="20" height="14" rx="3" fill="#ef5350"/>
        <text x="64" y="138" text-anchor="middle"
              font-family="Syne,sans-serif" font-size="7" font-weight="800"
              fill="white">RIDE!</text>

        <!-- ══════ CAR ══════ -->
        <g transform="translate(100,156)">

          <!-- shadow -->
          <ellipse cx="45" cy="55" rx="43" ry="7" fill="rgba(80,80,120,.18)"/>

          <!-- headlight glow on road -->
          <path d="M86 30 L138 18 L138 42 L86 36Z" fill="#fffde7" opacity=".3"/>

          <!-- car body -->
          <rect x="4" y="28" width="84" height="26" rx="9" fill="#6c63ff"/>
          <!-- lower body panel -->
          <rect x="4" y="43" width="84" height="11" rx="5.5" fill="#574fd6"/>

          <!-- cabin roof -->
          <path d="M18 28 Q22 9 40 7 L52 7 Q70 9 74 28Z" fill="#8b84ff"/>

          <!-- windshield -->
          <path d="M23 27 Q27 12 40 10 L52 10 Q64 12 68 27Z" fill="#e8e6ff" opacity=".65"/>
          <!-- windshield glare -->
          <path d="M27 25 Q29 15 36 13 L40 13 Q33 15 31 25Z" fill="white" opacity=".35"/>

          <!-- left window -->
          <rect x="20" y="17" width="17" height="11" rx="3.5" fill="#e8e6ff" opacity=".5"/>
          <rect x="20" y="17" width="17" height="11" rx="3.5" fill="none" stroke="#a09aff" stroke-width=".8" opacity=".5"/>
          <!-- right window -->
          <rect x="55" y="17" width="17" height="11" rx="3.5" fill="#e8e6ff" opacity=".5"/>
          <rect x="55" y="17" width="17" height="11" rx="3.5" fill="none" stroke="#a09aff" stroke-width=".8" opacity=".5"/>

          <!-- body side stripe -->
          <rect x="4" y="38" width="84" height="2.5" rx="1.2" fill="#4940b8" opacity=".5"/>
          <!-- door line -->
          <line x1="46" y1="28" x2="46" y2="54" stroke="#4940b8" stroke-width="1.2" opacity=".4"/>
          <!-- door handles -->
          <rect x="29" y="38" width="9" height="2.5" rx="1.2" fill="#4940b8" opacity=".65"/>
          <rect x="56" y="38" width="9" height="2.5" rx="1.2" fill="#4940b8" opacity=".65"/>

          <!-- headlights -->
          <rect x="85" y="27" width="7" height="7"  rx="3.5" fill="#fffde7"/>
          <rect x="85" y="37" width="7" height="4"  rx="2"   fill="#ffeb3b" opacity=".8"/>

          <!-- tail lights -->
          <rect x="0" y="27" width="5" height="6"  rx="2.5" fill="#ff5252" opacity=".9"/>
          <rect x="0" y="36" width="5" height="4"  rx="2"   fill="#d50000" opacity=".7"/>

          <!-- FRONT WHEEL -->
          <circle cx="72" cy="54" r="12" fill="#2d2d3e"/>
          <circle cx="72" cy="54" r="8"  fill="#424268"/>
          <circle cx="72" cy="54" r="4.5" fill="#6c63ff"/>
          <circle cx="72" cy="54" r="1.8" fill="#c4bfff"/>
          <line x1="72" y1="46" x2="72" y2="62" stroke="#5554a0" stroke-width="1.3" opacity=".6"/>
          <line x1="64" y1="54" x2="80" y2="54" stroke="#5554a0" stroke-width="1.3" opacity=".6"/>
          <line x1="67" y1="48" x2="77" y2="60" stroke="#5554a0" stroke-width="1"   opacity=".5"/>
          <line x1="77" y1="48" x2="67" y2="60" stroke="#5554a0" stroke-width="1"   opacity=".5"/>
          <circle cx="70" cy="51" r="1.6" fill="white" opacity=".28"/>

          <!-- REAR WHEEL -->
          <circle cx="19" cy="54" r="12" fill="#2d2d3e"/>
          <circle cx="19" cy="54" r="8"  fill="#424268"/>
          <circle cx="19" cy="54" r="4.5" fill="#6c63ff"/>
          <circle cx="19" cy="54" r="1.8" fill="#c4bfff"/>
          <line x1="19" y1="46" x2="19" y2="62" stroke="#5554a0" stroke-width="1.3" opacity=".6"/>
          <line x1="11" y1="54" x2="27" y2="54" stroke="#5554a0" stroke-width="1.3" opacity=".6"/>
          <line x1="14" y1="48" x2="24" y2="60" stroke="#5554a0" stroke-width="1"   opacity=".5"/>
          <line x1="24" y1="48" x2="14" y2="60" stroke="#5554a0" stroke-width="1"   opacity=".5"/>
          <circle cx="17" cy="51" r="1.6" fill="white" opacity=".28"/>

          <!-- SPEECH BUBBLE -->
          <g transform="translate(14,-52)">
            <rect x="0" y="0" width="64" height="35" rx="13"
                  fill="white" stroke="rgba(108,99,255,.28)" stroke-width="1.2"
                  filter="url(#bshadow)"/>
            <path d="M15 35 Q20 44 27 35Z" fill="white"/>
            <text x="32" y="14" text-anchor="middle"
                  font-family="Syne,sans-serif" font-size="8.5" font-weight="800"
                  fill="#7b6ff0">No rides</text>
            <text x="32" y="26" text-anchor="middle"
                  font-family="Syne,sans-serif" font-size="8.5" font-weight="800"
                  fill="#6c63ff">yet! 🗺️</text>
          </g>

          <!-- roof luggage rack detail -->
          <rect x="28" y="6"  width="36" height="2" rx="1" fill="#7c76e0" opacity=".5"/>
          <rect x="32" y="4"  width="4"  height="4" rx="1" fill="#7c76e0" opacity=".4"/>
          <rect x="56" y="4"  width="4"  height="4" rx="1" fill="#7c76e0" opacity=".4"/>

        </g><!-- /car -->

        <!-- small birds in sky -->
        <path d="M100 38 Q102 35 104 38" stroke="#5588aa" stroke-width="1.2" fill="none" stroke-linecap="round"/>
        <path d="M108 32 Q110 29 112 32" stroke="#5588aa" stroke-width="1.2" fill="none" stroke-linecap="round"/>
        <path d="M115 40 Q117 37 119 40" stroke="#5588aa" stroke-width="1.2" fill="none" stroke-linecap="round"/>

      </svg>
      <!-- ══════════════ /SVG ══════════════ -->
    </div>

    <!-- CHIP -->
    <div class="chip">
      <i class="fa-solid fa-car-side" style="font-size:.6rem;"></i>
      No rides yet
    </div>

    <!-- TITLE -->
    <div class="etitle">Ready to <span>hit the road?</span></div>

    <!-- DESC -->
    <div class="edesc">
      You haven't created or joined any rides yet.
      Create a ride room, plan your route, add the crew and go! 🚗
    </div>

  </div><!-- /empty -->


<script src="/js/noride.js"></script>

</body>