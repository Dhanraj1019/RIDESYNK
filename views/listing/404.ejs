<% layout("/layout/boilerplate.ejs") %>
<body>
<!-- sky & atmosphere -->
<div class="sky"></div>
<div class="sun"></div>
<div class="clouds">
  <div class="cloud c1"></div>
  <div class="cloud c2"></div>
  <div class="cloud c3"></div>
</div>
 
<!-- road -->
<div class="road-wrap">
  <div class="kerb"></div>
  <div class="road">
    <div class="road-dashes">
      <div class="dash"></div><div class="dash"></div><div class="dash"></div>
      <div class="dash"></div><div class="dash"></div><div class="dash"></div>
      <div class="dash"></div><div class="dash"></div><div class="dash"></div>
      <div class="dash"></div><div class="dash"></div><div class="dash"></div>
    </div>
  </div>
</div>
 
<!-- car -->
<div class="car-wrap">
  <div class="puff">
    <div class="p"></div><div class="p"></div><div class="p"></div>
  </div>
  <svg class="car-svg" viewBox="0 0 200 90" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- body -->
    <rect x="10" y="42" width="180" height="38" rx="10" fill="#FF2D55"/>
    <!-- cabin -->
    <path d="M55 42 C58 18, 75 14, 90 14 L130 14 C145 14, 155 18, 158 42 Z" fill="#FF5577"/>
    <!-- windshield -->
    <path d="M100 18 L128 18 C140 18, 150 24, 153 38 L103 38 Z" fill="#ADE4FF" opacity=".9"/>
    <!-- rear window -->
    <path d="M70 18 L100 18 L100 38 L60 38 C62 28, 65 20, 70 18 Z" fill="#ADE4FF" opacity=".85"/>
    <!-- side stripe -->
    <rect x="10" y="57" width="180" height="6" rx="3" fill="rgba(0,0,0,.12)"/>
    <!-- door line -->
    <line x1="110" y1="44" x2="110" y2="78" stroke="rgba(0,0,0,.15)" stroke-width="1.5"/>
    <!-- door handle -->
    <rect x="115" y="58" width="16" height="4" rx="2" fill="white" opacity=".6"/>
    <rect x="70" y="58" width="16" height="4" rx="2" fill="white" opacity=".6"/>
    <!-- headlight -->
    <rect x="170" y="48" width="18" height="10" rx="5" fill="#FFD60A"/>
    <rect x="174" y="50" width="10" height="6" rx="3" fill="white" opacity=".8"/>
    <!-- taillight -->
    <rect x="12" y="48" width="12" height="10" rx="5" fill="#CC0033"/>
    <!-- wheels -->
    <circle class="wheel" cx="52" cy="80" r="14" fill="#1A1A2E"/>
    <circle cx="52" cy="80" r="9" fill="#2D2D3A"/>
    <circle cx="52" cy="80" r="4" fill="#888"/>
    <line x1="52" y1="73" x2="52" y2="87" stroke="#555" stroke-width="1.5"/>
    <line x1="45" y1="80" x2="59" y2="80" stroke="#555" stroke-width="1.5"/>
 
    <circle class="wheel" cx="150" cy="80" r="14" fill="#1A1A2E"/>
    <circle cx="150" cy="80" r="9" fill="#2D2D3A"/>
    <circle cx="150" cy="80" r="4" fill="#888"/>
    <line x1="150" y1="73" x2="150" y2="87" stroke="#555" stroke-width="1.5"/>
    <line x1="143" y1="80" x2="157" y2="80" stroke="#555" stroke-width="1.5"/>
  </svg>
</div>
 
<!-- CONTENT CARD -->
<div class="shell">
  <div class="card" style="background: transparent;">
 
    <a class="brand" href="#">
      <div class="brand-dot">
        <svg width="17" height="17" viewBox="0 0 20 20" fill="white">
          <path d="M3.5 9.5L5.3 5H14.7L16.5 9.5M2 11H18V15.5H2V11ZM5 15.5C5 16.33 4.33 17 3.5 17S2 16.33 2 15.5 2.67 14 3.5 14 5 14.67 5 15.5ZM18 15.5C18 16.33 17.33 17 16.5 17S15 16.33 15 15.5 15.67 14 16.5 14 18 14.67 18 15.5Z"/>
        </svg>
      </div>
      <span class="brand-name">Ridesynk</span>
    </a>
 
    <div class="status-code" id="errCode">
      <%=status %>
    </div>
 
    <div class="status-pill">
      <span class="pill-dot"></span>
      <span id="errLabel">
        <%= message %>
      </span>
    </div>
 
    <p class="message" id="errMsg">
      Looks like this road doesn't exist. The destination you're looking for may have been moved or never existed.
    </p>
 
    <div class="road-divider">
      <div class="rd-line"></div>
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" style="color:#BABACE">
        <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5"/>
        <path d="M10 6v4l2.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <div class="rd-line"></div>
    </div>
 
    <div class="actions">
      <a class="btn-home" href="/ridesynk/home">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M2 8l6-6 6 6M3.5 6.5V13h3.5v-3h2v3h3.5V6.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Return Home
      </a>
      <div class="btn-row">
        <button class="btn-secondary" onclick="history.back()">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
            <path d="M6 4l-4 4 4 4M2 8h12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Go Back
        </button>
        <a class="btn-secondary" 
          href="https://mail.google.com/mail/?view=cm&fs=1&to=support@ridesynk.com&su=ridesynk Support&body=Hello"
          target="_blank">
          Support
        </a>
      </div>
    </div>
 
    <p class="err-ref">Error ref: <code id="errRef"></code></p>
  </div>
</div>
 
</body>