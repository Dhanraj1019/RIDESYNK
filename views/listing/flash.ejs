<% if(success && success.length){ %>
    <div class="alert alert-success alert-dismissible fade show" style="position: fixed;top: .3rem;width: 100%;z-index:2999;" role="alert">
        <strong>
            <%= success %>
        </strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<% if(error && error.length){ %>
    <div class="alert alert-danger alert-dismissible fade show" style="position: fixed;top: .3rem;width: 100%;z-index:2999;" role="alert">
        <strong>
            <%= error %>
        </strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>