<% layout("/layout/boilerplate.ejs") %>

<%
  const firstName = (data.firstname || data.firstName || "").trim();
  const lastName = (data.lastname || data.lastName || "").trim();
  const fullName = `${firstName} ${lastName}`.trim() || data.username || "Not Provided";
  const username = data.username ? `@${data.username}` : "@not-available";
  const email = data.email || "Not Provided";
  const phone = data.phone || data.phonenumber || "Not Provided";
  const vehicle = data.vehicle || data.vehical || "Not Provided";
  const role = String(data.role || "user").toLowerCase() === "admin" ? "Admin" : "User";
  const avatarLetter = (fullName[0] || "U").toUpperCase();
%>

<main class="profile-page" aria-label="Profile">
  <section class="profile-shell">
    <h1 class="page-title">Profile</h1>

    <article class="profile-header-card" aria-label="Profile Header">
      <div class="avatar-circle"><%= avatarLetter %></div>
      <div class="header-meta">
        <h2 class="profile-fullname"><%= fullName %></h2>
        <p class="profile-username"><%= username %></p>
        <div class="profile-meta-row">
          <span class="role-badge role-<%= role.toLowerCase() %>"><%= role %></span>
          <span class="profile-email"><%= email %></span>
        </div>
      </div>
    </article>

    
    <section class="stats-section" aria-label="Profile Stats">
      <div class="stats-grid">
        <article class="stat-card">
          <p class="stat-value"><%= rides.length %></p>
          <p class="stat-label">Rides</p>
        </article>
        <article class="stat-card">
          <p class="stat-value">
            <%=data.travel.totalDistance ? (data.travel.totalDistance) : 0%> km
          </p>
          <p class="stat-label">Distance</p>
        </article>
        <article class="stat-card">
          <p class="stat-value"><%= rides.length %></p>
          <p class="stat-label">Members</p>
        </article>
      </div>
    </section>

    <article class="details-card" aria-label="User Details Card">
      <header class="details-card-head">
        <h3>User Details</h3>
      </header>

      <div class="detail-grid" role="list">
        <div class="detail-item" role="listitem">
          <p class="detail-label">Full Name</p>
          <p class="detail-value"><%= fullName %></p>
        </div>

        <div class="detail-item" role="listitem">
          <p class="detail-label">Username</p>
          <p class="detail-value"><%= username %></p>
        </div>

        <div class="detail-item" role="listitem">
          <p class="detail-label">Email Address</p>
          <p class="detail-value detail-value-icon">
            <i class="bi bi-envelope"></i>
            <span><%= email %></span>
          </p>
        </div>

        <div class="detail-item" role="listitem">
          <p class="detail-label">Mobile Number</p>
          <p class="detail-value detail-value-icon">
            <i class="bi bi-telephone"></i>
            <span><%= phone %></span>
          </p>
        </div>

        <div class="detail-item detail-item-wide" role="listitem">
          <p class="detail-label">Vehicle</p>
          <p class="detail-value detail-value-icon">
            <i class="bi bi-bicycle"></i>
            <span><%= vehicle %></span>
          </p>
        </div>
      </div>
    </article>

  </section>
</main>

<script src="/js/profile.js"></script>
