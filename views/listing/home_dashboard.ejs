<% layout("/layout/boilerplate.ejs") %>

<%
  const getInitials = (user) => {
    if (user.firstname?.length > 0 && user.lastname?.length > 0) {
      return user.firstname[0].toUpperCase() + user.lastname[0].toUpperCase();
    }
    return (user.username?.[0] || '?').toUpperCase();
  };

  const getFullName = (user) => {
    if (user.firstname && user.lastname) {
      return user.firstname + " " + user.lastname;
    }
    return user.username || 'User';
  };
%>

<body>
  <div class="page">
    <div class="brand-bar">RideSynk</div>

    <div class="header-row">
      <button class="avatar-trigger" id="open-drawer">
        <div class="avatar-circle" id="avatar-initials">
          <%= getInitials(data) %>
        </div>
        <div>
          <p class="greeting-sub" id="greeting-text">Good Morning</p>
          <p class="greeting-name" id="user-name">
            <%= getFullName(data) %>
          </p>
        </div>
      </button>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <p class="stat-value">
          <%= rides.length %>
        </p><p class="stat-label">Total Rides</p>
      </div>
      <div class="stat-card" style="animation-delay:0.05s">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <p class="stat-value">
          <%= members %>
        </p><p class="stat-label">Members</p>
      </div>
      <div class="stat-card" style="animation-delay:0.1s">
        <svg fill="#000000" height="20" width="20" version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 459.682 459.682" xml:space="preserve" stroke="#000000"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g id="XMLID_957_"> <g> <g> <path d="M404.48,174.639c0-14.544-6.314-28.346-17.322-37.869c-2.297-1.987-3.138-5.124-2.143-7.991 c4.774-13.751,3.341-28.863-3.932-41.46c-7.272-12.596-19.642-21.392-33.938-24.134c-2.981-0.572-5.278-2.869-5.85-5.851 c-2.742-14.295-11.538-26.665-24.135-33.937c-12.212-7.052-27.262-8.858-41.455-3.933c-2.846,0.99-6.019,0.142-7.992-2.139 C258.191,6.315,244.388,0,229.842,0s-28.349,6.315-37.871,17.324c-1.975,2.285-5.148,3.13-7.992,2.141 c-14.167-4.917-29.221-3.132-41.457,3.932c-12.596,7.273-21.393,19.642-24.135,33.935c-0.572,2.983-2.868,5.28-5.849,5.852 c-14.297,2.742-26.667,11.538-33.939,24.135c-7.273,12.597-8.706,27.708-3.933,41.459c0.996,2.869,0.155,6.006-2.141,7.992 c-11.009,9.522-17.322,23.324-17.322,37.869c0,14.544,6.314,28.346,17.322,37.869c2.297,1.986,3.138,5.123,2.142,7.991 c-4.773,13.75-3.34,28.862,3.933,41.459c7.278,12.605,19.647,21.404,33.938,24.14c2.982,0.571,5.279,2.867,5.851,5.851 c0.929,4.843,2.569,9.456,4.8,13.733l-42.744,95.924c-4.059,9.108,2.73,19.378,12.715,19.197l46.333-0.854l30.345,35.023 c6.539,7.546,18.712,5.741,22.777-3.381l37.226-83.54l37.226,83.54c4.072,9.139,16.25,10.913,22.777,3.381l30.345-35.023 l46.333,0.854c10.05,0.147,16.757-10.126,12.715-19.197l-42.744-95.924c2.232-4.278,3.871-8.891,4.801-13.735 c0.572-2.982,2.868-5.278,5.85-5.849c14.291-2.737,26.662-11.536,33.938-24.14c7.273-12.597,8.706-27.709,3.933-41.458 c-0.996-2.868-0.155-6.005,2.142-7.991C398.167,202.987,404.48,189.184,404.48,174.639z M176.419,420.89l-20.481-23.637 c-2.595-2.995-6.359-4.71-10.312-4.71c-0.084,0-0.169,0.001-0.252,0.003l-31.27,0.577l29.655-66.55 c10.928,5.915,23.829,7.