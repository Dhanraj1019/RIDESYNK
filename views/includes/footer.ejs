<!-- ════════ FOOTER NAV ════════ -->
<% if(curruser) { %>
  <%
    const _u = (originalUrl || '').toLowerCase();
    const _isHome = _u.endsWith('/home') || _u.endsWith('/saveprofile');
    const _isRides = /^\/ridesync\/[^/]+\/rides$/.test(_u);
    const _isProfile = _u.endsWith('/profile');
    const _isSettings = _u.endsWith('/settings');
  %>
  <nav class="footer-nav" role="navigation" aria-label="Main navigation">

    <button class="nav-item <%= _isHome ? 'active' : '' %>" id="nav-home" onclick="window.location.href='/ridesync/home'">
      <span class="nav-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/>
          <polyline points="9 21 9 13 15 13 15 21"/>
        </svg>
      </span>
      <span class="nav-label">Home</span>
    </button>


    <button class="nav-item <%= _isRides ? 'active' : '' %>" id="nav-rides" onclick="window.location.href='/ridesync/<%= curruser._id %>/rides'">
      <span class="nav-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="6" cy="19" r="3"/><circle cx="18" cy="5" r="3"/>
          <path d="M12 19h4.5a3.5 3.5 0 0 0 0-7h-8a3.5 3.5 0 0 1 0-7H12"/>
        </svg>
      </span>
      <span class="nav-label">Rides</span>
    </button>

    <button class="nav-item <%= _isProfile ? 'active' : '' %>" id="nav-profile" onclick="window.location.href='/ridesync/profile'">
      <span class="nav-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </span>
      <span class="nav-label">Profile</span>
    </button>

    <button class="nav-item <%= _isSettings ? 'active' : '' %>" id="nav-settings" onclick="window.location.href='/ridesync/settings'">
      <span class="nav-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"/>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
        </svg>
      </span>
      <span class="nav-label">Settings</span>
    </button>
  </nav>
<% } %>